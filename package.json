{
  "name": "staynest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test --config playwright.pwa.config.ts",
    "e2e:prepare": "node scripts/e2e-prepare.mjs",
    "depcheck": "depcruise apps packages --config .dependency-cruiser.cjs",
    "knip": "knip",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.dev.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker-compose.dev.yml logs -f",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:migrate:down": "node scripts/db-migrate.mjs down",
    "db:migrate:test": "node scripts/db-migrate.mjs up --test",
    "db:reset": "node scripts/db-reset.mjs",
    "db:reset:test": "node scripts/db-reset.mjs --test",
    "db:codegen": "node scripts/db-codegen.mjs",
    "vapid:generate": "pnpm --filter @staynest/api vapid:generate",
    "seed:perf": "node scripts/seed-perf.mjs",
    "perf:search": "node scripts/perf-search.mjs",
    "perf:http": "node scripts/perf-http.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@playwright/test": "^1.64.1",
    "dependency-cruiser": "^18.6.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
