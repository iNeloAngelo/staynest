{
  "name": "@staynest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "node scripts/seed-demo/index.mjs",
    "seed:demo:clean": "node scripts/seed-demo/index.mjs --clean",
    "og:generate": "node scripts/generate-og-image.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@node-rs/argon2": "^2.2.2",
    "@staynest/shared": "workspace:*",
    "blurhash": "^2.0.5",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.7",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
