# Скопируйте в .env и при необходимости измените значения.
# В git попадает только этот файл, без реальных секретов.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3100
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true — только если API стоит за доверенным прокси (Caddy) и порт наружу не опубликован
TRUST_PROXY=false

# Postgres: локальный compose или staging на VPS через SSH-туннель (ADR-027)
POSTGRES_USER=staynest
POSTGRES_PASSWORD=staynest
POSTGRES_DB=staynest
DATABASE_URL=postgres://staynest:staynest@localhost:5433/staynest
# База для интеграционных тестов схемы: сбрасывается перед прогоном
DATABASE_URL_TEST=postgres://staynest:staynest@localhost:5433/staynest_test
# Таймаут одного запроса к БД, мс (health-check и будущие запросы)
DB_QUERY_TIMEOUT_MS=5000

# MinIO (docker-compose.dev.yml)
MINIO_ROOT_USER=staynest
MINIO_ROOT_PASSWORD=staynest-minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=staynest-media
# В production обязательны S3_ENDPOINT, S3_BUCKET и секрет (S3_SECRET_KEY или MINIO_ROOT_PASSWORD).
# S3_ACCESS_KEY / S3_SECRET_KEY по умолчанию берутся из MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публичный префикс раздачи вариантов фото (Caddy проксирует в бакет)
MEDIA_PUBLIC_PATH=/media
PHOTO_MAX_UPLOAD_BYTES=10485760
PHOTO_MAX_PER_LISTING=20
PHOTO_MAX_PIXELS=32000000

# Mailpit (docker-compose.dev.yml)
# 127.0.0.1, а не localhost: Node может выбрать IPv6 (::1), а контейнер слушает IPv4.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=StayNest <no-reply@staynest.local>

# Авторизация. JWT_SECRET обязателен в production (не короче 32 символов).
# Сгенерируйте: openssl rand -base64 48
JWT_SECRET=
APP_WEB_URL=http://localhost:5173
REQUIRE_EMAIL_VERIFICATION=true
# Таймзона объявлений: от неё считается «сегодня» для заезда и календаря
LISTING_TIME_ZONE=Europe/Moscow
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
