{$DOMAIN} {
	# SSE нельзя сжимать: gzip/zstd буферизует кадры и ломает реальное время.
	@notEvents not path /api/v1/me/events
	encode @notEvents zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SW, его runtime-файлы, manifest и index.html должны перепроверяться:
	# иначе браузер продолжит запускать старую оболочку и не увидит обновление.
	@navigation not path /assets/* /media/* /api/* /sitemap.xml /robots.txt
	header @navigation Cache-Control "no-cache"

	# Поисковые роботы и превью мессенджеров получают HTML с Open Graph из API.
	@crawler {
		path / /listings/*
		header_regexp User-Agent "(?i)(bot|crawler|spider|facebookexternalhit|telegram|whatsapp|twitterbot|slackbot|discordbot|linkedinbot|vkshare)"
	}

	handle @crawler {
		reverse_proxy api:3100
	}

	handle /sitemap.xml {
		reverse_proxy api:3100
	}

	handle /robots.txt {
		reverse_proxy api:3100
	}

	handle /media/listings/* {
		@notAllowed not method GET HEAD
		respond @notAllowed 405
		# Бакет публичный только на listings/* (политику ставит API).
		uri strip_prefix /media
		rewrite * /{$S3_BUCKET:staynest-media}{uri}
		reverse_proxy silo:9000
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
	}

	handle /media/avatars/* {
		@notAllowed not method GET HEAD
		respond @notAllowed 405
		# Публичная раздача только квадратных WebP-аватаров (политику ставит API).
		uri strip_prefix /media
		rewrite * /{$S3_BUCKET:staynest-media}{uri}
		reverse_proxy silo:9000
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
	}

	# SSE требует отключённой буферизации, иначе события копятся в прокси.
	handle /api/v1/me/events {
		reverse_proxy api:3100 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:3100
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
