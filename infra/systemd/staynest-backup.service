[Unit]
Description=StayNest backup (Postgres + Silo bucket)
Documentation=file:///opt/staynest/docs/ops.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/staynest
ExecStart=/bin/bash /opt/staynest/scripts/prod-backup.sh
Nice=10
IOSchedulingClass=idle
