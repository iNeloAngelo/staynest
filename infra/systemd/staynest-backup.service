[Unit]
Description=StayNest backup (Postgres + Silo bucket)
Documentation=file:///opt/staynest/docs/ops.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/staynest
ExecStart=/bin/bash /opt/staynest/scripts/prod-backup.sh
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=-/home/deploy/backups
