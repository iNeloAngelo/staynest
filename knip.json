{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["db/migrations/**"],
  "ignoreBinaries": ["tsx", "vite"],
  "ignoreDependencies": ["@vitest/coverage-v8"],
  "workspaces": {
    "apps/api": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
